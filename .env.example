# ========================================================
# ARCHIVO DE CONFIGURACIÓN DE ENTORNO PARA ORACLE OCI
# Copiar este archivo a .env antes de levantar con docker compose:
#   cp .env.example .env
# ========================================================

# Configuración de Base de Datos MySQL
DB_NAME=ventasfix
DB_USER=ventasfix_user
DB_PASSWORD=ventasfix_pass123_segura
DB_ROOT_PASSWORD=admin123_root_segura
DB_PORT=3306

# Configuración del Backend
BACKEND_PORT=8080
JWT_SECRET=94a08da1fecbb6e8b46990538c7b50b2b8c5f7d2f9e1e9a3b2c1d0e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0
JWT_EXPIRATION=86400000

# Configuración del Frontend
# Si usas Nginx en puerto 80 con proxy inverso, déjalo en '/api'
# Si expones los puertos por separado, usa: http://<TU_IP_PUBLICA_OCI>:8080/api
VITE_API_URL=/api
FRONTEND_PORT=80
