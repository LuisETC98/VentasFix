      "item": [
        {
          "name": "01 - Login Exitoso (200 OK)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Respuesta contiene token JWT', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData.token).to.be.a('string').and.not.empty;",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    if (pm.environment) { pm.environment.set('jwt_token', jsonData.token); }",
                  "});",
                  "",
                  "pm.test('Tiempo de respuesta menor a 1500ms', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1500);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
