                  "pm.test('Regla de negocio: Backend recalcula precioVenta en base al nuevo precioNeto', function () {",
                  "    var prod = pm.response.json();",
                  "    pm.expect(prod.nombre).to.include('v2 Pro');",
                  "    pm.expect(prod.precioNeto).to.eql(200000);",
                  "    // 200000 + 19% = 238000",
                  "    pm.expect(prod.precioVenta).to.be.closeTo(238000, 0.01);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
